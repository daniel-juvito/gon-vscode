{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Gon",
  "scopeName": "source.gon",
  "patterns": [
    { "include": "#comments" },
    { "include": "#strings" },
    { "include": "#keywords" },
    { "include": "#types" },
    { "include": "#numbers" },
    { "include": "#operators" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-slash.gon",
          "match": "//.*$"
        },
        {
          "name": "comment.block.gon",
          "begin": "/\\*",
          "end": "\\*/"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.gon",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            { "name": "constant.character.escape.gon", "match": "\\\\." }
          ]
        },
        {
          "name": "string.quoted.raw.gon",
          "begin": "`",
          "end": "`"
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.gon",
          "match": "\\b(if|else|for|range|switch|case|default|return|break|continue|go|defer|select|fallthrough)\\b"
        },
        {
          "name": "keyword.declaration.gon",
          "match": "\\b(package|import|func|var|const|type|struct|interface|map|chan)\\b"
        },
        {
          "name": "constant.language.gon",
          "match": "\\b(true|false|nil|iota)\\b"
        }
      ]
    },
    "types": {
      "patterns": [
        {
          "name": "storage.type.gon",
          "match": "\\b(bool|byte|complex64|complex128|error|float32|float64|int|int8|int16|int32|int64|rune|string|uint|uint8|uint16|uint32|uint64|uintptr)\\b"
        },
        {
          "name": "keyword.operator.nonnil.gon",
          "match": "!"
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.gon",
          "match": "\\b(0[xX][0-9a-fA-F_]+|0[bB][01_]+|0[oO][0-7_]+|[0-9][0-9_]*)\\b"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.assignment.gon",
          "match": "(:=|=|\\+=|-=|\\*=|/=|%=)"
        },
        {
          "name": "keyword.operator.comparison.gon",
          "match": "(==|!=|<=|>=|<|>)"
        }
      ]
    }
  }
}
