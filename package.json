{
  "name": "gon",
  "displayName": "Gon",
  "description": "Language support and diagnostics for the Gon nil-safety language. Consumer of Diagnostic Protocol v1 via gon check --json.",
  "version": "0.1.0",
  "publisher": "daniel-juvito",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Programming Languages",
    "Linters"
  ],
  "activationEvents": [
    "onLanguage:gon"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "languages": [
      {
        "id": "gon",
        "aliases": [
          "Gon",
          "gon"
        ],
        "extensions": [
          ".gon"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "gon",
        "scopeName": "source.gon",
        "path": "./syntaxes/gon.tmLanguage.json"
      }
    ],
    "configuration": {
      "title": "Gon",
      "properties": {
        "gon.path": {
          "type": "string",
          "default": "gon",
          "description": "Path to the gon executable (must support check --json, Diagnostic Protocol v1)."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "test": "npm run compile && node out/test/runTest.js"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/vscode": "^1.85.0",
    "typescript": "^5.3.3"
  }
}
